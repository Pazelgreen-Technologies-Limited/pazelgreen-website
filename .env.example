# Deployment environment, independent of NODE_ENV (next build uses production).
APP_ENV=development
POSTGRES_DB=pazelgreen
POSTGRES_USER=pazelgreen
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5433
DEV_DATABASE_URL=postgresql://pazelgreen:replace-with-local-password@127.0.0.1:5433/pazelgreen
# No fallback to development. Set production values in deployment secrets.
PRODUCTION_DATABASE_URL=
# Separate disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SERVER_URL=http://localhost:3000
# Dev defaults: storage/public and storage/private, both outside public/.
# Production requires absolute, persistent mounted paths for BOTH directories.
PUBLIC_UPLOAD_DIR=
PRIVATE_UPLOAD_DIR=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=cms@pazelgreen.test
# One-time CLI bootstrap only. Remove after setup. Never exposed via HTTP.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
