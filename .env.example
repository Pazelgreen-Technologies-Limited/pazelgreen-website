# Deployment environment, independent of NODE_ENV (next build uses production).
APP_ENV=development
DEV_DATABASE_URL=
# No fallback to development. Set production values in deployment secrets.
PRODUCTION_DATABASE_URL=
# Separate disposable PostgreSQL database for integration tests.
TEST_DATABASE_URL=
PAYLOAD_SECRET=
SERVER_URL=http://localhost:3000
# Dev defaults: storage/public and storage/private, both outside public/.
# Filesystem production mode requires persistent absolute paths for BOTH.
# S3 mode disables local upload writes and does not require persistent mounts.
PUBLIC_UPLOAD_DIR=
PRIVATE_UPLOAD_DIR=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
# Automatic first-admin creation on pnpm dev / pnpm start. Remove after setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# S3-compatible storage (Supabase now; R2 later).
# Server-only credentials. Bucket must remain private.
# Complete S3 values select S3 automatically outside tests. Set local to opt out.
# Tests use local storage unless explicitly pointed at the loopback simulator.
STORAGE_DRIVER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
