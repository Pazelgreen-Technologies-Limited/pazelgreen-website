{
  "name": "pazelgreen-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": { "node": "^22.23.4 || >=24.22.1" },
  "scripts": {
    "predev": "tsx scripts/database.ts up && payload migrate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "tsx scripts/database.ts up",
    "db:stop": "tsx scripts/database.ts stop",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "payload migrate",
    "cms:migration:create": "payload migrate:create",
    "cms:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:http": "tsx tests/http/cms-smoke.ts"
  },
  "dependencies": {
    "@next/env": "16.3.3",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "graphql": "16.11.0",
    "lucide-react": "^1.18.0",
    "next": "16.3.3",
    "payload": "3.93.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pg": "8.23.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
